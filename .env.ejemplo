# Plantilla de configuracion para PostgreSQL.
# Copiela como .env en la raiz del proyecto y ajuste los valores.
# El archivo .env no se versiona: esta incluido en .gitignore.
#
# Spring Boot lo carga automaticamente gracias a:
#   spring.config.import=optional:file:./.env[.properties]
# Las variables de entorno reales (por ejemplo, las de Render) tienen prioridad.

# PostgreSQL local
DB_URL=jdbc:postgresql://localhost:5432/DB-INTEGRADOR-3S
DB_USER=postgres
DB_PASSWORD=cambie_esta_clave

# PostgreSQL en la nube (Aiven, Neon, Supabase, ...): use el host, puerto y base
# que le dio el proveedor y agregue ?sslmode=require al final de la URL.
# DB_URL=jdbc:postgresql://pg-xxxxxxxx-mixto.e.aivencloud.com:23333/defaultdb?sslmode=require
# DB_USER=avnadmin
# DB_PASSWORD=cambie_esta_clave

# Opcional: tamano maximo del pool de conexiones (por defecto 5).
# DB_POOL_SIZE=5

# En Render NO defina PORT: la plataforma lo asigna automaticamente.
